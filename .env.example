# ─── Core ──────────────────────────────────────────────────────────────
# Supabase → Project settings → Database → Connection string (use the pooled "Transaction" URI, port 6543)
DATABASE_URI=postgresql://postgres.<project-ref>:<password>@aws-0-eu-west-2.pooler.supabase.com:6543/postgres
# CMS tables live in their own schema (isolated from anything else in the database)
DATABASE_SCHEMA=cms
# Long random string: `openssl rand -hex 32`
PAYLOAD_SECRET=
# Public address of the site (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://cahn.org.uk
# Protects the scheduled-publishing cron endpoint
CRON_SECRET=

# ─── CMS sign-in with existing CAHN Supabase accounts ─────────────────
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
# Pre-creates this person's CMS admin account on first deploy (they sign in with their Supabase password)
SEED_ADMIN_EMAIL=

# ─── Media storage: Vercel Blob (preferred) ───────────────────────────
BLOB_READ_WRITE_TOKEN=

# ─── or Media storage: Supabase Storage (S3-compatible) ───────────────
# Supabase → Storage → Settings → S3 Connection. Leave blank to store uploads on local disk (dev only).
S3_BUCKET=media
S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
S3_REGION=eu-west-2
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ─── Email (choose one) ───────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=info@cahn.org.uk
# Inbox that receives website enquiries
ENQUIRIES_TO=info@cahn.org.uk
# or SMTP (e.g. Microsoft 365: smtp.office365.com:587)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ─── Payments ─────────────────────────────────────────────────────────
# Stripe (international). Use sk_test_… until you are ready to go live.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Paystack (African payments). Use sk_test_… until live.
PAYSTACK_SECRET_KEY=

# ─── Optional ─────────────────────────────────────────────────────────
# Cloudflare Turnstile spam protection for forms
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
